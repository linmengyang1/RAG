# ════════════════════════════════════════════════
# Graduate RAG 环境变量模板
# 使用方法：cp .env.example .env  然后填值
# ════════════════════════════════════════════════

# ───── PostgreSQL ─────
# 注意：宿主机端口改成 15432，避免和 Dify 的 5432 冲突
POSTGRES_USER=grad
POSTGRES_PASSWORD=grad123
POSTGRES_DB=grad_rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432                # 容器内端口（不变）

# ───── Milvus ─────
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_CHUNKS=chunks
MILVUS_COLLECTION_WIKI=wiki

# ───── MinIO（文件存储 + Milvus 依赖）─────
# 注意：宿主机端口改成 19000/19001，避免和 Dify 的 9000/9001 冲突
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=grad-rag

# ───── 数据路径 ─────
# 容器内挂载位置（docker-compose.yml 已映射）
DATA_OUTPUT_DIR=/data/output
MINERU_CACHE_DIR=/data/mineru_cache

# ───── DeepSeek LLM API ─────
# 官方文档：https://api-docs.deepseek.com/
# 主力用 v4-flash（便宜），Wiki 生成用 v4-pro（旗舰）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MAIN_MODEL=deepseek-v4-flash      # 主力（RAG 问答）
DEEPSEEK_WIKI_MODEL=deepseek-v4-pro        # Wiki 生成（结构化沉淀）
# 是否使用 mock 实现（未填 API key 时自动启用）
LLM_USE_MOCK=false

# ───── MinerU API（精准解析）─────
# 官方文档：https://mineru.net/apiManage/docs
# 流程：申请上传链接 → PUT 文件 → 系统自动解析 → 轮询 batch → 下载 zip
# 申请地址：https://mineru.net/apiManage（注册后在「API 管理」获取 token）
MINERU_API_TOKEN=your-mineru-jwt-token-here
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm               # pipeline(默认) / vlm(推荐) / MinerU-HTML
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=ch                      # 中文文档
# 单文件超时（秒），轮询间隔（秒）
MINERU_TIMEOUT=600
MINERU_POLL_INTERVAL=5
MINERU_USE_MOCK=false

# ───── 本地模型（4090）─────
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 推理设备：cpu / cuda
TORCH_DEVICE=cuda
# 是否在启动时加载（占用显存常驻）
EMBED_LAZY_LOAD=true
RERANKER_LAZY_LOAD=true

# ───── JWT 鉴权 ─────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_EXP_MINUTES=10080            # 7 天
# 完全关闭鉴权（仅本地内网用，关闭后所有接口无需登录）
AUTH_DISABLED=false

# ───── 应用 ─────
APP_ENV=development              # development / production
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000"]
